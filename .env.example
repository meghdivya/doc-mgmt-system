ENVIRONMENT=local
DATABASE_URL=sqlite:///./data/vault.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25

CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
TOP_K_CHUNKS=5

# Preferred: OpenRouter API (supports openai/gpt-4o, embeddings, HTTP-Referer & X-Title headers)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_SITE_NAME=Vault AI Document System

# Alternative: Direct OpenAI API
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: distributed task queue & caching
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
RATE_LIMIT_PER_MINUTE=120
